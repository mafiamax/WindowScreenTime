<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>8.0.15</RuntimeFrameworkVersion>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>WindowScreenTime</AssemblyName>
    <RootNamespace>WindowScreenTime</RootNamespace>
    <Title>WindowScreenTime</Title>
    <AssemblyTitle>WindowScreenTime</AssemblyTitle>
    <Product>WindowScreenTime</Product>
    <Company>WindowScreenTime</Company>
    <Copyright>Copyright (c) 2026</Copyright>
    <Description>Windows 11 Ekran ve Kullanım Süresi Takipçisi</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Installer\**" />
    <Page Remove="Installer\**" />
    <EmbeddedResource Remove="Installer\**" />
    <None Remove="Installer\**" />
  </ItemGroup>

</Project>

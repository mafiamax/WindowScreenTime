<Window x:Class="WindowScreenTime.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hakkında - Windows Screen Time"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        KeyDown="Window_KeyDown">

    <Border Background="{StaticResource BgPrimaryBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- Başlık çubuğu (sürüklenebilir) -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0,0,0,4">
                <TextBlock Text="Hakkında"
                           Margin="20,14,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,8,0"
                        Width="30"
                        Height="28"
                        Padding="0"
                        FontSize="12"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTip="Kapat (Esc)"
                        Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Margin="24,0,24,22">
                <!-- Simge, ad ve sürüm -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Image x:Name="AppIconImage"
                           Width="52"
                           Height="52"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows Screen Time"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText"
                                   Text="Sürüm"
                                   FontSize="12.5"
                                   Foreground="{StaticResource AccentBlueBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Kısa tanıtım -->
                <TextBlock TextWrapping="Wrap"
                           FontSize="12.5"
                           LineHeight="19"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,16"
                           Text="Bilgisayarınızda aktif, boşta ve uykuda geçen süreyi sistem tepsisinden sessizce takip eder; günlük özetleri, grafikleri ve oturum saatlerini gösterir. Tüm veriler yalnızca bu bilgisayarda saklanır, hiçbir yere gönderilmez."/>

                <!-- Künye -->
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,12"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="KÜNYE"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#818CF8"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style x:Key="LabelText" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Setter Property="Margin" Value="0,3,16,3"/>
                                </Style>
                                <Style x:Key="ValueText" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="Foreground" Value="#F3F4F6"/>
                                    <Setter Property="Margin" Value="0,3,0,3"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="Proje Sahibi"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}" Text="Erhan.M" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}" Text="Geliştirme"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="Claude (Anthropic) ve Gemini (Google) ile geliştirildi"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="Kaynak Kod"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}">
                                <Hyperlink x:Name="RepoLink"
                                           Foreground="#38BDF8"
                                           RequestNavigate="RepoLink_RequestNavigate">
                                    <Run x:Name="RepoLinkText" Text="github.com/mafiamax/WindowScreenTime"/>
                                </Hyperlink>
                            </TextBlock>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}" Text="Telif"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="© 2026 Erhan.M"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Eylemler -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CheckUpdateButton"
                            Grid.Column="0"
                            Content="Güncellemeleri Kontrol Et"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="12,8"
                            ToolTip="GitHub üzerinden yeni sürüm olup olmadığını kontrol eder"
                            Click="CheckUpdateButton_Click"/>
                    <Button x:Name="OpenDataFolderButton"
                            Grid.Column="2"
                            Content="Veri Klasörünü Aç"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="12,8"
                            ToolTip="Kullanım geçmişinin ve ayarların saklandığı klasörü açar (yedekleme veya sıfırlama için)"
                            Click="OpenDataFolderButton_Click"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

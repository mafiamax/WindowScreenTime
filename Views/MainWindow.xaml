<Window x:Class="WindowScreenTime.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Screen Time"
        Width="1040"
        Height="760"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Closing="MainWindow_Closing">

    <!-- Renklere DynamicResource ile başvurulur: tema (Koyu/Açık) çalışma anında değişebilir. -->
    <Window.Resources>
        <!-- DataGrid Tema Stilleri -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridHeaderFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource GridRowBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridRowFgBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridRowBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GridRowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GridRowSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource GridRowSelectedFgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="LegendDot" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="12,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="225"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK & ANLIK DURUM -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Windows Screen Time"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border x:Name="StatusBadgeBorder"
                            Background="{DynamicResource StatusActiveBgBrush}"
                            BorderBrush="{DynamicResource StatusActiveBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,3"
                            Margin="14,2,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource StatusActiveDotBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusBadgeText"
                                       Text="Aktif Takip Ediliyor"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource StatusActiveTextBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Günlük aktif kullanım, boşta kalma süreleri ve oturum geçmişi"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ImportEventLogButton"
                        Content="Olay Günlüğünü Tara"
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTipService.ShowDuration="20000"
                        Click="ImportEventLogButton_Click">
                    <Button.ToolTip>
                        <TextBlock MaxWidth="320" TextWrapping="Wrap">
                            Geçmiş günleri Windows Olay Günlüğü'nden doldurur.
                            <LineBreak/><LineBreak/>
                            Not: Olay Günlüğü yalnızca bilgisayarın açık kaldığı süreyi bilir; kilitli,
                            ekranı kapalı veya boşta geçen zamanı ayırt edemez. Bu yüzden aktarılan
                            "Aktif" süreler yüksek görünebilir. Uygulamanın kendi ölçtüğü günlere dokunulmaz.
                        </TextBlock>
                    </Button.ToolTip>
                </Button>
                <Button Content="Tepsiye Küçült"
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="Pencereyi gizler; takip sistem tepsisinde devam eder (X tuşu da aynı işi yapar)"
                        Click="MinimizeToTrayButton_Click"/>
                <Button x:Name="AboutButton"
                        Content="Hakkında"
                        Style="{StaticResource ModernButtonStyle}"
                        ToolTip="Uygulama bilgileri, künye ve güncelleme kontrolü"
                        Click="AboutButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. ÖZET KARTLARI (3 KART) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kart 1: Bugünkü Aktif Süre -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <StackPanel>
                    <TextBlock Text="BUGÜNKÜ AKTİF SÜRE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlueBrush}"/>
                    <TextBlock x:Name="TodayActiveText"
                               Text="0 dk"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,6,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TodayIdleSubtext"
                               Text="Boşta geçen: 0 dk  •  Toplam: 0 dk"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Kart 2: Günlük Ortalama Kullanım -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <StackPanel>
                    <TextBlock Text="GÜNLÜK ORTALAMA KULLANIM"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentIndigoBrush}"/>
                    <TextBlock x:Name="Avg7DaysText"
                               Text="0 dk"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,6,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="Avg30DaysSubtext"
                               Text="Son 7 gün ortalaması  •  30 Gün: 0 dk"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Kart 3: Bugünkü İlk Açılış & Son Aktiflik -->
            <Border Grid.Column="4"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <StackPanel>
                    <TextBlock Text="BUGÜNKÜ OTURUM SAATLERİ"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentGreenBrush}"/>
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="İlk Açılış" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TodayFirstSeenText" Text="--:--" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Son Aktiflik" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TodayLastSeenText" Text="--:--" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TodayDateSubtext"
                               Text="--"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. GÜN GÜN KULLANIM GRAFİĞİ (Aktif / Boşta / Uyku yığılı çubuk) -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Günlük Kullanım Grafiği"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChartMaxInfoText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,1,0,0"/>

                        <!-- Gösterge -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,1,0,0">
                            <Border Style="{StaticResource LegendDot}" Background="{DynamicResource ChartActiveBrush}"/>
                            <TextBlock Text="Aktif" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource LegendDot}" Background="{DynamicResource ChartIdleBrush}"/>
                            <TextBlock Text="Boşta" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource LegendDot}" Background="{DynamicResource ChartSleepBrush}"/>
                            <TextBlock Text="Uykuda" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="Range7Btn"
                                Content="Son 7 Gün"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="Range7Btn_Click"/>
                        <Button x:Name="Range14Btn"
                                Content="Son 14 Gün"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="Range14Btn_Click"/>
                        <Button x:Name="Range30Btn"
                                Content="Son 30 Gün"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="10,4"
                                Click="Range30Btn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Grafik Çizim Alanı -->
                <ItemsControl x:Name="ChartItemsControl" Grid.Row="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="3,0" ToolTip="{Binding TooltipText}" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding TopValueLabel}"
                                           FontSize="10"
                                           Foreground="{DynamicResource ChartLabelBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"/>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource ChartTrackBrush}"
                                        CornerRadius="5"
                                        VerticalAlignment="Stretch">
                                    <!-- Yukarıdan aşağıya: Uyku, Boşta, Aktif (Aktif en altta) -->
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Border Height="{Binding SleepHeight}"
                                                CornerRadius="{Binding SleepCorner}"
                                                Background="{DynamicResource ChartSleepBrush}"/>
                                        <Border Height="{Binding IdleHeight}"
                                                CornerRadius="{Binding IdleCorner}"
                                                Background="{DynamicResource ChartIdleBrush}"/>
                                        <Border Height="{Binding ActiveHeight}"
                                                CornerRadius="{Binding ActiveCorner}"
                                                Background="{Binding ActiveBrush}"/>
                                        <Border Height="{Binding EmptyHeight}"
                                                CornerRadius="5"
                                                Background="{DynamicResource ChartEmptyBrush}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding DayLabel}"
                                           FontSize="10.5"
                                           Foreground="{Binding LabelBrush}"
                                           FontWeight="{Binding LabelWeight}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 4. DETAYLI GÜNLÜK TABLO -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="2"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,10,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Günlük Geçmiş (son 30 gün)"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="ExportCsvButton"
                            Grid.Column="1"
                            Content="CSV Olarak Dışa Aktar"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="10,4"
                            ToolTip="Kayıtlı tüm günleri Excel'de açılabilen bir CSV dosyasına kaydeder"
                            Click="ExportCsvButton_Click"/>
                </Grid>

                <DataGrid x:Name="HistoryDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding DisplayDate}" Width="1.35*"/>
                        <DataGridTextColumn Header="İlk Açılış" Binding="{Binding FirstSeenFormatted}" Width="0.8*"/>
                        <DataGridTextColumn Header="Son Aktiflik" Binding="{Binding LastSeenFormatted}" Width="0.8*"/>
                        <DataGridTextColumn Header="Aktif Süre" Binding="{Binding ActiveFormatted}" Width="1.05*"/>
                        <DataGridTextColumn Header="Boşta Geçen Süre" Binding="{Binding IdleFormatted}" Width="1.05*"/>
                        <DataGridTextColumn Header="Uykuda Geçen Süre" Binding="{Binding SleepFormatted}" Width="1.05*"/>
                        <DataGridTextColumn Header="Toplam Açık" Binding="{Binding TotalFormatted}" Width="1.0*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 5. ALT AYARLAR & ÇIKIŞ ÇUBUĞU -->
        <Border Grid.Row="4"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Dar pencerelerde alt satıra kayar -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="StartupCheckBox"
                              Content="Windows ile başlat"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              FontSize="12.5"
                              Cursor="Hand"
                              Margin="0,4,24,4"
                              ToolTip="Windows oturumu açıldığında uygulama sistem tepsisinde otomatik başlar"
                              Checked="StartupCheckBox_Changed"
                              Unchecked="StartupCheckBox_Changed"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,24,4">
                        <TextBlock Text="Boşta sayma:" Style="{StaticResource SettingLabel}"
                                   ToolTip="Bu süre boyunca klavye ve fareye dokunulmazsa süre Boşta sayılır"/>
                        <ComboBox x:Name="IdleTimeoutComboBox"
                                  Width="90"
                                  SelectionChanged="IdleTimeoutComboBox_SelectionChanged">
                            <ComboBoxItem Content="1 dakika" Tag="1"/>
                            <ComboBoxItem Content="3 dakika" Tag="3"/>
                            <ComboBoxItem Content="5 dakika" Tag="5"/>
                            <ComboBoxItem Content="10 dakika" Tag="10"/>
                            <ComboBoxItem Content="15 dakika" Tag="15"/>
                            <ComboBoxItem Content="30 dakika" Tag="30"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,24,4">
                        <TextBlock Text="Mola hatırlatma:" Style="{StaticResource SettingLabel}"
                                   ToolTip="Bu kadar süre kesintisiz aktif kullanımdan sonra sistem tepsisinden mola bildirimi gösterilir. Boşta sayma süresi kadar ara vermek sayacı sıfırlar."/>
                        <ComboBox x:Name="BreakReminderComboBox"
                                  Width="90"
                                  SelectionChanged="BreakReminderComboBox_SelectionChanged">
                            <ComboBoxItem Content="Kapalı" Tag="0"/>
                            <ComboBoxItem Content="30 dakika" Tag="30"/>
                            <ComboBoxItem Content="45 dakika" Tag="45"/>
                            <ComboBoxItem Content="50 dakika" Tag="50"/>
                            <ComboBoxItem Content="60 dakika" Tag="60"/>
                            <ComboBoxItem Content="90 dakika" Tag="90"/>
                            <ComboBoxItem Content="120 dakika" Tag="120"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,24,4">
                        <TextBlock Text="Tema:" Style="{StaticResource SettingLabel}"/>
                        <ComboBox x:Name="ThemeComboBox"
                                  Width="80"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Koyu" Tag="Dark"/>
                            <ComboBoxItem Content="Açık" Tag="Light"/>
                            <ComboBoxItem Content="Sistem" Tag="System"/>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <Button Grid.Column="1"
                        Content="Uygulamadan Çık"
                        Style="{StaticResource ModernButtonStyle}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        Foreground="{DynamicResource DangerFgBrush}"
                        VerticalAlignment="Center"
                        ToolTip="Takibi durdurur ve uygulamayı tamamen kapatır (X tuşu yalnızca tepsiye küçültür)"
                        Click="ExitAppButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

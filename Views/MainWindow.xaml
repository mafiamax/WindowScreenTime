<Window x:Class="WindowScreenTime.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Screen Time"
        Width="1080"
        Height="760"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Closing="MainWindow_Closing">

    <!-- Renklere DynamicResource ile başvurulur: tema (Koyu/Açık) çalışma anında değişebilir. -->
    <Window.Resources>
        <!-- DataGrid Tema Stilleri -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridHeaderFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource GridRowBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridRowFgBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridRowBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GridRowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GridRowSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource GridRowSelectedFgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LegendDot" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="12,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="225"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK & ANLIK DURUM -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Windows Screen Time"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border x:Name="StatusBadgeBorder"
                            Background="{DynamicResource StatusActiveBgBrush}"
                            BorderBrush="{DynamicResource StatusActiveBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,3"
                            Margin="14,2,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource StatusActiveDotBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusBadgeText"
                                       Text="Aktif Takip Ediliyor"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource StatusActiveTextBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Günlük aktif kullanım, boşta kalma süreleri ve oturum geçmişi"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Simgeler Windows'un yerleşik simge yazı tipinden gelir (Windows 11: Segoe Fluent Icons,
                     Windows 10: Segoe MDL2 Assets); ayrı resim dosyası gerekmez. -->
                <Button x:Name="SettingsButton"
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="Windows ile başlat, boşta sayma, mola hatırlatıcısı, günlük hedef, tema ve veri yedekleme"
                        Click="SettingsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontWeight="Normal" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Ayarlar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AboutButton"
                        Style="{StaticResource ModernButtonStyle}"
                        ToolTip="Uygulama bilgileri, künye ve güncelleme kontrolü"
                        Click="AboutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontWeight="Normal" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Hakkında" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. ÖZET KARTLARI (3 KART) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kart 1: Bugünkü Aktif Süre -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <StackPanel>
                    <TextBlock Text="BUGÜNKÜ AKTİF SÜRE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlueBrush}"/>
                    <TextBlock x:Name="TodayActiveText"
                               Text="0 dk"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,6,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TodayIdleSubtext"
                               Text="Boşta geçen: 0 dk  •  Toplam: 0 dk"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Kart 2: Günlük Ortalama Kullanım -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <StackPanel>
                    <TextBlock Text="GÜNLÜK ORTALAMA KULLANIM"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentIndigoBrush}"/>
                    <TextBlock x:Name="Avg7DaysText"
                               Text="0 dk"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,6,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="Avg30DaysSubtext"
                               Text="Son 7 gün ortalaması  •  30 Gün: 0 dk"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Kart 3: Bugünkü İlk Açılış & Son Aktiflik -->
            <Border Grid.Column="4"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <StackPanel>
                    <TextBlock Text="BUGÜNKÜ OTURUM SAATLERİ"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentGreenBrush}"/>
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="İlk Açılış" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TodayFirstSeenText" Text="--:--" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Son Aktiflik" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TodayLastSeenText" Text="--:--" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TodayDateSubtext"
                               Text="--"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. GÜN GÜN KULLANIM GRAFİĞİ (Aktif / Boşta / Uyku yığılı çubuk) -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Günlük Kullanım Grafiği"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChartMaxInfoText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,1,0,0"/>

                        <!-- Gösterge -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,1,0,0">
                            <Border Style="{StaticResource LegendDot}" Background="{DynamicResource ChartActiveBrush}"/>
                            <TextBlock Text="Aktif" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource LegendDot}" Background="{DynamicResource ChartIdleBrush}"/>
                            <TextBlock Text="Boşta" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource LegendDot}" Background="{DynamicResource ChartSleepBrush}"/>
                            <TextBlock Text="Uykuda" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel x:Name="GoalLegend" Orientation="Horizontal" Visibility="Collapsed">
                                <Border Width="12" Height="2" Margin="12,0,5,0" VerticalAlignment="Center" Background="{DynamicResource ChartGoalBrush}"/>
                                <TextBlock x:Name="GoalLegendText" Text="Hedef" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="Range7Btn"
                                Content="Son 7 Gün"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="Range7Btn_Click"/>
                        <Button x:Name="Range14Btn"
                                Content="Son 14 Gün"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="Range14Btn_Click"/>
                        <Button x:Name="Range30Btn"
                                Content="Son 30 Gün"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="10,4"
                                Click="Range30Btn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Grafik Çizim Alanı -->
                <ItemsControl x:Name="ChartItemsControl" Grid.Row="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="3,0" ToolTip="{Binding TooltipText}" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding TopValueLabel}"
                                           FontSize="10"
                                           Foreground="{DynamicResource ChartLabelBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"/>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource ChartTrackBrush}"
                                        CornerRadius="5"
                                        VerticalAlignment="Stretch">
                                    <Grid>
                                    <!-- Yukarıdan aşağıya: Uyku, Boşta, Aktif (Aktif en altta) -->
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Border Height="{Binding SleepHeight}"
                                                CornerRadius="{Binding SleepCorner}"
                                                Background="{DynamicResource ChartSleepBrush}"/>
                                        <Border Height="{Binding IdleHeight}"
                                                CornerRadius="{Binding IdleCorner}"
                                                Background="{DynamicResource ChartIdleBrush}"/>
                                        <Border Height="{Binding ActiveHeight}"
                                                CornerRadius="{Binding ActiveCorner}"
                                                Background="{Binding ActiveBrush}"/>
                                        <Border Height="{Binding EmptyHeight}"
                                                CornerRadius="5"
                                                Background="{DynamicResource ChartEmptyBrush}"/>
                                    </StackPanel>
                                    <!-- Günlük hedef çizgisi (yan yana çubuklarda kesik çizgi gibi görünür) -->
                                    <Border Height="2"
                                            VerticalAlignment="Bottom"
                                            Margin="{Binding GoalMargin}"
                                            Visibility="{Binding GoalVisibility}"
                                            Background="{DynamicResource ChartGoalBrush}"
                                            IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding DayLabel}"
                                           FontSize="10.5"
                                           Foreground="{Binding LabelBrush}"
                                           FontWeight="{Binding LabelWeight}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 4. DETAYLI GÜNLÜK TABLO -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="2"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,10,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Günlük Geçmiş"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox x:Name="HistoryRangeComboBox"
                                  Width="120"
                                  VerticalAlignment="Center"
                                  ToolTip="Tabloda gösterilecek dönem: son 30 gün veya kayıtlı bir ay"
                                  SelectionChanged="HistoryRangeComboBox_SelectionChanged"/>
                        <TextBlock x:Name="HistorySummaryText"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,12,0"/>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="ResetHistoryButton"
                                Content="Geçmişi Sıfırla"
                                Style="{StaticResource ModernButtonStyle}"
                                BorderBrush="{DynamicResource DangerBorderBrush}"
                                Foreground="{DynamicResource DangerFgBrush}"
                                Padding="10,4"
                                Margin="0,0,8,0"
                                ToolTip="Temiz başlangıç: bugün dahil tüm kayıtlı günleri siler ve sayaçları sıfırdan başlatır. Silmeden önce onay sorulur ve geçmiş veri klasörüne yedeklenir; ayarlar korunur."
                                Click="ResetHistoryButton_Click"/>
                        <Button x:Name="ExportCsvButton"
                                Content="CSV Olarak Dışa Aktar"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="10,4"
                                ToolTip="Kayıtlı tüm günleri Excel'de açılabilen bir CSV dosyasına kaydeder"
                                Click="ExportCsvButton_Click"/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="HistoryDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding DisplayDate}" Width="1.35*"/>
                        <DataGridTextColumn Header="İlk Açılış" Binding="{Binding FirstSeenFormatted}" Width="0.8*"/>
                        <DataGridTextColumn Header="Son Aktiflik" Binding="{Binding LastSeenFormatted}" Width="0.8*"/>
                        <DataGridTextColumn Header="Aktif Süre" Binding="{Binding ActiveFormatted}" Width="1.05*"/>
                        <DataGridTextColumn Header="Boşta Geçen Süre" Binding="{Binding IdleFormatted}" Width="1.05*"/>
                        <DataGridTextColumn Header="Uykuda Geçen Süre" Binding="{Binding SleepFormatted}" Width="1.05*"/>
                        <DataGridTextColumn Header="Toplam Açık" Binding="{Binding TotalFormatted}" Width="1.0*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 5. ALT AYARLAR & ÇIKIŞ ÇUBUĞU -->
        <Border Grid.Row="4"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Geçerli ayarların özeti (ayarlar "Ayarlar" penceresinden değiştirilir) -->
                <TextBlock x:Name="SettingsSummaryText"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0"
                           Cursor="Hand"
                           ToolTip="Ayarları değiştirmek için tıklayın"
                           MouseLeftButtonUp="SettingsSummaryText_MouseLeftButtonUp"/>

                <Button Grid.Column="1"
                        Content="Uygulamadan Çık"
                        Style="{StaticResource ModernButtonStyle}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        Foreground="{DynamicResource DangerFgBrush}"
                        VerticalAlignment="Center"
                        ToolTip="Takibi durdurur ve uygulamayı tamamen kapatır (X tuşu yalnızca tepsiye küçültür)"
                        Click="ExitAppButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

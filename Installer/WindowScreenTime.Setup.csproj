<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>8.0.15</RuntimeFrameworkVersion>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\Assets\app.ico</ApplicationIcon>
    <AssemblyName>WindowScreenTime_Setup</AssemblyName>
    <RootNamespace>WindowScreenTime.Setup</RootNamespace>
    <Title>WindowScreenTime Setup</Title>
    <Product>WindowScreenTime Installer</Product>
    <Company>Erhan.M</Company>
    <Copyright>Copyright (c) 2026 Erhan.M</Copyright>
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" Condition="Exists('payload.zip')" />
  </ItemGroup>

</Project>

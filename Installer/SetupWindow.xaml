<Window x:Class="WindowScreenTime.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowScreenTime v1.0.0 Kurulum Sihirbazı"
        Width="520"
        Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#14161B"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="WindowScreenTime Kurulumu"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#F3F4F6"/>
            <TextBlock Text="Windows 11 Ekran ve Kullanım Süresi Takipçisi (v1.0.0)"
                       FontSize="13"
                       Foreground="#38BDF8"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Kurulum Dizini Bilgisi -->
        <Border Grid.Row="1"
                Background="#1E222B"
                BorderBrush="#2D3340"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="KURULUM DİZİNİ"
                           FontSize="10.5"
                           FontWeight="Bold"
                           Foreground="#9CA3AF"/>
                <TextBlock x:Name="InstallPathText"
                           Text=""
                           FontSize="12"
                           Foreground="#E5E7EB"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Seçenekler & Durum -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <CheckBox x:Name="DesktopShortcutCheck"
                      Content="Masaüstü kısayolu oluştur"
                      IsChecked="True"
                      Foreground="#F3F4F6"
                      FontSize="13"
                      Margin="0,0,0,10"
                      Cursor="Hand"/>
            <CheckBox x:Name="StartMenuShortcutCheck"
                      Content="Başlat Menüsü kısayolu oluştur"
                      IsChecked="True"
                      Foreground="#F3F4F6"
                      FontSize="13"
                      Margin="0,0,0,10"
                      Cursor="Hand"/>
            <CheckBox x:Name="LaunchAfterInstallCheck"
                      Content="Kurulum tamamlandığında WindowScreenTime'ı başlat"
                      IsChecked="True"
                      Foreground="#F3F4F6"
                      FontSize="13"
                      Margin="0,0,0,14"
                      Cursor="Hand"/>

            <TextBlock x:Name="StatusText"
                       Text="Kuruluma hazır."
                       FontSize="12.5"
                       Foreground="#9CA3AF"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Alt Butonlar -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelBtn"
                    Content="İptal"
                    Width="95"
                    Height="34"
                    Background="#262B36"
                    Foreground="#F3F4F6"
                    BorderBrush="#374151"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Click="CancelBtn_Click"/>
            <Button x:Name="InstallBtn"
                    Content="Kurulumu Başlat"
                    Width="150"
                    Height="34"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderBrush="#3B82F6"
                    Cursor="Hand"
                    Click="InstallBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
